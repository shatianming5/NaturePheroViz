# Copy to .env (this file is ignored by git) and fill in your key.
# Prefer GOOGLE_API_KEY for Gemini via langchain-google-genai.
GOOGLE_API_KEY=your_key_here

# Option B: call Gemini through local CLIProxyAPI (recommended if you already run it)
# This is the inbound bearer key from CLIProxyAPI/config.yaml -> api-keys (not the upstream model key).
# If you run CLIProxyAPI with a non-default config file, set CLIPROXY_CONFIG to that file path.
CLIPROXY_CONFIG=CLIProxyAPI/config.yaml
CLIPROXY_BASE_URL=http://localhost:8317
CLIPROXY_API_KEY=your_proxy_bearer_key_here
